#!/usr/bin/env sh
set -eu

if command -v xtensa-esp32s3-elf-gcc >/dev/null 2>&1; then
    exec xtensa-esp32s3-elf-gcc "$@"
fi

compiler_path="$(find "$HOME/.espressif/tools" -path '*xtensa-esp32s3-elf-gcc' -type f 2>/dev/null | sort | tail -n 1)"
if [ -z "$compiler_path" ]; then
    echo "xtensa-esp32s3-elf-gcc was not found. Run 'espup install' first." >&2
    exit 1
fi

exec "$compiler_path" "$@"
